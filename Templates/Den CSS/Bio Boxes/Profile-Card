.Bio {
  width:85%;
  height:400px;
  color:var(--font-color-main);
  display:grid;
  grid-template-columns: 1fr;
  grid-template-rows: 2fr 8fr 1fr;
  border-radius:var(--border-radius);
  overflow:hidden;
  border-collapse:separate;
}

.Bio img {
  display: block;
  margin:auto;
  width:80%;
}

.Bio br {
  display:none !important;
}

.Bio img {
  display: block;
  margin:auto;
  width:100%;
}

.Bio a {
  color:var(--font-color-main) !important;
}

.Bio a:hover {
  color:var(--accent-color-light) !important;
}

.Bio .BioHeader {
  background:var(--bg-header-dark);
  border:var(--border-size-small) solid var(--border-color);
  border-top-left-radius:var(--border-radius-big);
  border-top-right-radius:var(--border-radius-big);
}

.Bio .BioHeader h1 {
  text-align:center;
  font-size:40px;
}

.Bio .BioMain {
  background:var(--bg-header-light);
  text-align:left;
  border:var(--border-size-small) solid var(--border-color);
  display:grid;
  grid-template-columns:4fr 3fr;
  gap:10px;
  max-height:300px;
}

.Bio .BioMain div:nth-child(1) {
  overflow-x:hidden;
  overflow-y:scroll;
}

.Bio .BioMain div:nth-child(1)::-webkit-scrollbar {
  display:none;
}
  
.Bio .BioMain h2 {
  color:var(--font-color-main);
  text-align:center;
}

.Bio .BioMain p {
  color:var(--font-color-main);
  text-align:left;
  padding:5px;
}

.Bio .BioMainLeft {
  padding-left:15px;
  padding-right:15px
}

.Bio .BioMainImg {
  margin:auto;
  border:4px solid var(--border-color);
  margin-right:10px;
}

.Bio .BioFooter {
  display:grid;
  grid-template-rows:1fr;
  grid-template-columns:1fr 1fr 1fr 1fr ;
  padding:5px;
  gap:10px;
  background:var(--bg-header-dark);
  border:var(--border-size-small) solid var(--border-color);
  border-bottom-left-radius:var(--border-radius-big);
  border-bottom-right-radius:var(--border-radius-big);
}

.Bio .BioLink {
  border:1px solid var(--border-color);
  box-shadow:0px 0px 5px 1px var(--border-color) inset;
  border-radius:var(--border-radius-small);
  margin:5px
}

.Bio .BioLink:hover {
  background:var(--bg-header-light);
  border-color:var(--accent-color-light);
  box-shadow:0px 0px 5px 1px var(--accent-color-light) inset;
}

.Bio .BioLink a {
  font-size:17px;
}

.Bio .BioLink:hover a {
  color:var(--accent-color-light) !important;
}
