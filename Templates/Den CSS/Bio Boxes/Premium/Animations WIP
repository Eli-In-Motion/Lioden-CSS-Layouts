.Bio .BioBottom {
  grid-column-start:1;
  grid-column-end:3;
  display:grid;
  grid-template-columns:auto 1fr;
  grid-template-rows: 1fr 1fr 1fr 1fr;
  gap:0;border:var(--border-size-small) solid var(--border-color);
}

.BioPlaceholder {
  grid-column-start:2;
  grid-row-start:1;;
  grid-row-end:5;
}

.Bio .BioTab1,
.Bio .BioTab2,
.Bio .BioTab3,
.Bio .BioTab4 {
  grid-column-start:1;
  border-style:none solid solid none;border-width:var(--border-size-small);
  border-color:var(--border-color);
  display: flex;
  align-items: center;
  justify-content:center;
}

.Bio .BioTab4 {
  border-bottom:none;
}

.Bio .BioTab1Content,
.Bio .BioTab2Content,
.Bio .BioTab3Content,
.Bio .BioTab4Content {
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  border:1px solid yellow;
  background:red;
  opacity:0;
  clip-path: inset(0 100% 0 0);
}

@keyframes slide {
  from {clip-path: inset(0% 100% 0% 0%)}
  to {clip-path: inset(0% 0% 0% 0%)}
}

.Bio .BioTab1:hover ~ .BioTab1Content,
.Bio .BioTab2:hover ~ .BioTab2Content,
.Bio .BioTab3:hover ~ .BioTab3Content,
.Bio .BioTab4:hover  ~ .BioTab4Content {
  opacity:1;
  pointer-events: auto;
  animation:slide 2s forwards;
}

.Bio .BioTab1Content:hover,
.Bio .BioTab2Content:hover,
.Bio .BioTab3Content:hover,
.Bio .BioTab4Content:hover {
  opacity:1;
  pointer-events: auto;
  animation:slide 2s forwards;
}
