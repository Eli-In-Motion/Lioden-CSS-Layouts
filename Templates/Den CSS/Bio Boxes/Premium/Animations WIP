.Bio {
  border:1px solid red;
  color:var(--font-color-main);
  display:grid;
  grid-template-columns:2fr 1fr;
  grid-template-rows:auto 150px 200px auto;
  gap:10px;
  width:90%;
}

.Bio br {
  display:none;
}

.Bio img {
  max-width:80%;
}

.Bio .BioHeader {
  border:1px solid blue;
  padding:10px;
}

.Bio .BioHeader h1 {
  margin:0;
}

.Bio .BioHeader2 {
  border:1px solid blue;
  padding:10px;
  display:flex;
  justify-content:center;
  align-items:center;
}

.Bio .BioHeader2 p {
  margin:0;
}

.Bio .BioLeft {
  border:1px solid green;
  grid-row-start:2;
  grid-row-end:4;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioRightTop {
  border:1px solid green;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioRightTop h2 {
  margin:0;
  color:var(--font-color-main);
}

.Bio .BioRightTop p {
  margin:0;
  text-align:left;
}

.Bio .BioRightBottom {
  border:1px solid green;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioRightBottom h2 {
  margin:0;
  color:var(--font-color-main);
}

.Bio .BioRightBottom p {
  margin:0;
  text-align:left;
}

.Bio .BioBottom {
  border:1px solid yellow;
