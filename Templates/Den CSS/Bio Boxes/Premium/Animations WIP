~~~~~~~~~~Slide in on hover tab
.Bio {
  background:var(--bg-panel-left);
  color:var(--font-color-main);
  border:var(--border-size-big) solid var(--border-color);
  border-radius:var(--border-radius-big);
  display:grid;
  grid-template-columns:2fr 1fr;
  grid-template-rows:auto 150px 200px 200px;
  grid-row-gap:10px;
  width:90%;
  padding:20px;
}

.Bio br {
  display:none;
}

.Bio img {
  max-width:80%;
}

.Bio .BioHeader {
  background:var(--bg-header-light);
  border-style:solid none solid solid;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  padding:10px;
}

.Bio .BioHeader h1 {
  margin:0;
}

.Bio .BioHeader2 {
  background:var(--bg-header-light);
  border-style:solid solid solid none;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  padding:10px;
  display:flex;
  justify-content:center;
  align-items:center;
}

.Bio .BioHeader2 p {
  margin:0;
}

.Bio .BioLeft {
  background:var(--bg-panel-right);
  border:var(--border-size-small) solid var(--border-color);
  grid-row-start:2;
  grid-row-end:4;
  overflow-x:hidden;
  overflow-y:auto;
  margin-right:20px;
}

.Bio .BioLeft::-webkit-scrollbar {
  width:10px;
}

.Bio .BioLeft::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioLeft::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioRightTop {
  background:var(--bg-chat-dark);
  border:var(--border-size-small) solid var(--border-color);
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioRightTop h2 {
  margin:0;
  color:var(--font-color-main);
}

.Bio .BioRightTop p {
  margin:0;
  text-align:left;
}

.Bio .BioRightBottom {
  background:var(--bg-chat-light);
  border:var(--border-size-small) solid var(--border-color);
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioRightBottom h2 {
  margin:0;
  color:var(--font-color-main);
}

.Bio .BioRightBottom p {
  margin:0;
  text-align:left;
}

.Bio .BioBottom {
  grid-column-start:1;
  grid-column-end:3;
  display:grid;
  grid-template-columns:auto 1fr;
  grid-template-rows: repeat(4, 1fr);
}

.Bio .BioTab1,
.Bio .BioTab2,
.Bio .BioTab3,
.Bio .BioTab4 {
  border:var(--border-size-small) solid var(--border-color);
  grid-column-start:1;
  display:flex;
  justify-items:center;
  align-items:center;
  background:var(--bg-panel-right);
}

.Bio .BioPlaceholder {
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  background:var(--bg-chat-dark);
  width:100%;
  border:var(--border-size-small) solid var(--border-color);
}

.Bio .BioTab1Content,
.Bio .BioTab2Content,
.Bio .BioTab3Content,
.Bio .BioTab4Content {
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  opacity:0;
  pointer-events:none;
  transition:opacity 1s, width .75s;
  width:0px;
  overflow-x:hidden;
  overflow-y:auto;
  background:var(--bg-chat-dark);
  border:var(--border-size-small) solid var(--border-color);
}

.Bio .BioTab1:hover ~ .BioTab1Content,
.Bio .BioTab2:hover ~ .BioTab2Content,
.Bio .BioTab3:hover ~ .BioTab3Content,
.Bio .BioTab4:hover ~ .BioTab4Content {
  opacity:1;
  pointer-events:auto;
  width:100%;
}

.Bio .BioTab1Content:hover,
.Bio .BioTab2Content:hover,
.Bio .BioTab3Content:hover,
.Bio .BioTab4Content:hover {
  opacity:1;
  pointer-events:auto;
  width:100%;
}

.Bio .BioTab1:hover ~ .BioPlaceholder,
.Bio .BioTab2:hover ~ .BioPlaceholder,
.Bio .BioTab3:hover ~ .BioPlaceholder,
.Bio .BioTab4:hover ~ .BioPlaceholder,
.Bio .BioTab1Content:hover ~ .BioPlaceholder,
.Bio .BioTab2Content:hover ~ .BioPlaceholder,
.Bio .BioTab3Content:hover ~ .BioPlaceholder,
.Bio .BioTab4Content:hover ~ .BioPlaceholder {
  pointer-events:none;
}
