.Bio {
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-rows:auto 100px 200px 200px;
  row-gap:20px;
  margin-bottom:30px;
  width:90%;
  color:var(--font-color-main);
}

.Bio br {
  display:none;
}

.Bio .BioHeader {
  padding:10px;
  border-width:1px 0px 1px 1px;
  border-style:solid;
  background:var(--bg-header-light);
  border-color:var(--border-color);
}

.Bio .BioHeader h1 {
  margin:0;
}

.Bio .BioHeader p {
  margin:0;
}

.Bio .BioHeader2 {
  display: flex;
  align-items: center;
  justify-content:center;
  background:var(--bg-header-light);
  border-width:1px 1px 1px 0px;
  border-style:solid;
  border-color:var(--border-color);
}

.Bio .BioLeft {
  grid-row-start:2;
  grid-row-end:4;
  margin-right:10px;
  overflow-x:hidden;
  overflow-y:auto;
  border:var(--border-size-small) solid var(--border-color);
}

.Bio .BioLeft img {
  width:90%;
}

.Bio .BioLeft::-webkit-scrollbar {
  width:10px;
}

.Bio .BioLeft::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioLeft::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioRightTop {
  border:var(--border-size-small) solid var(--border-color);
  overflow-x:hidden;
  overflow-y:auto;
  margin-left:10px;
  padding:10px;
}

.Bio .BioRightTop:hover {
  
}

.Bio .BioRightTop h2 {
  color:var(--font-color-main);
