<div class="Bio">
<div class="BioHeader"><h1>Header</h1></div>
<div class="BioHeader2">Side Details</div>
<div class="BioLeft"><p>Left Images Container</p><img src="https://github.com/Eli-In-Motion/Lioden-CSS-Layouts/blob/main/Personal%20Use/Images/Maia%20of%20Cylenne/Maia-by-Ysera1.png?raw=true" alt="" /></div>
<div class="BioRightTop"><h2>Right Top Div</h2><p>Details</p></div>
<div class="BioRightBottom"><h2>Right Bottom Div</h2><p>Details</p></div>
<div class="BioBottom">
  <div class="BioTab1">Tab 1</div>
  <div class="BioTab2">Tab 2</div>
  <div class="BioTab3">Tab 3</div>
  <div class="BioTab4">Tab 4</div>
  <div class="BioTab1Content">Tab 1 Content</div>
  <div class="BioTab2Content">Tab 2 Content</div>
  <div class="BioTab3Content">Tab 3 Content</div>
  <div class="BioTab4Content">Tab 4 Content</div>
  <div class="BioPlaceholder">Placeholder</div>
</div>
</div>

.Bio {
  background:var(--bg-panel-back);
  border:var(--border-size-big) solid var(--border-color);
  border-radius:var(--border-radius-big);
  color:var(--font-color-main);
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-rows:auto 100px 200px 200px;
  row-gap:15px;
  margin-bottom:30px;
  width:95%;
  padding:20px;
}

.Bio br {
  display:none;
}

.Bio .BioHeader {
  background:var(--bg-header-light);
  border-color:var(--border-color);
  border-width:1px 0px 1px 1px;
  border-style:solid;
  padding:10px;
  overflow:hidden;
}

.Bio .BioHeader h1,
.Bio .BioHeader p{
  margin:0;
}

.Bio .BioHeader2 {
  background:var(--bg-header-light);
  border-width:1px 1px 1px 0px;
  border-style:solid;
  border-color:var(--border-color);
  display: flex;
  align-items: center;
  justify-content:center;
  overflow:hidden;
}

.Bio .BioLeft {
  background:var(--bg-panel-left);
  border:var(--border-size-small) solid var(--border-color);
  grid-row-start:2;
  grid-row-end:4;
  margin-right:5px;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioLeft img {
  max-width:90%;
}

.Bio .BioLeft::-webkit-scrollbar {
  width:8px;
}

.Bio .BioLeft::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioLeft::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioRightTop {
  background:var(--bg-panel-right);
  border:var(--border-size-small) solid var(--border-color);
  overflow-x:hidden;
  overflow-y:auto;
  margin-left:5px;
  padding:10px
}

.Bio .BioRightTop h2 {
  color:var(--font-color-main);
  margin:0;
}

.Bio .BioRightTop::-webkit-scrollbar {
  width:8px;
}

.Bio .BioRightTop::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioRightTop::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioRightBottom {
  background:var(--bg-chat-light);
  border:var(--border-size-small) solid var(--border-color);
  overflow-x:hidden;
  overflow-y:auto;
  margin-left:5px;
  padding:20px
}

.Bio .BioRightBottom h2 {
  color:var(--font-color-main);
  margin:0;
}

.Bio .BioRightBottom::-webkit-scrollbar {
  width:8px;
}

.Bio .BioRightBottom::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioRightBottom::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioBottom {
  grid-column-start:1;
  grid-column-end:3;
  display:grid;
  grid-template-columns:auto 1fr;
  grid-template-rows: 1fr 1fr 1fr 1fr;
  gap:0;
}

.Bio .BioTab1,
.Bio .BioTab2,
.Bio .BioTab3,
.Bio .BioTab4 {
  background:var(--bg-chat-dark);
  border-style:solid none none solid;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  grid-column-start:1;
  display: flex;
  align-items: center;
  justify-content:center;
}

.Bio .BioTab4 {
  border-bottom:var(--border-size-small) solid var(--border-color);
}

.Bio .BioTab1:hover,
.Bio .BioTab2:hover,
.Bio .BioTab3:hover,
.Bio .BioTab4:hover {
  background:var(--bg-chat-light);
}

.Bio .BioTab1Content,
.Bio .BioTab2Content,
.Bio .BioTab3Content,
.Bio .BioTab4Content {
  background:var(--bg-panel-left);
  border:var(--border-size-small) solid var(--border-color);
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  opacity:0;
  clip-path: inset(0 100% 0 0);
  transition: clip-path .55s, opacity .25s;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioTab1Content::-webkit-scrollbar,
.Bio .BioTab2Content::-webkit-scrollbar,
.Bio .BioTab3Content::-webkit-scrollbar,
.Bio .BioTab4Content::-webkit-scrollbar {
  width:8px;
}

.Bio .BioTab1Content::-webkit-scrollbar-track,
.Bio .BioTab2Content::-webkit-scrollbar-track,
.Bio .BioTab3Content::-webkit-scrollbar-track,
.Bio .BioTab4Content::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.Bio .BioTab1Content::-webkit-scrollbar-thumb,
.Bio .BioTab2Content::-webkit-scrollbar-thumb,
.Bio .BioTab3Content::-webkit-scrollbar-thumb,
.Bio .BioTab4Content::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.Bio .BioTab1:hover ~ .BioTab1Content,
.Bio .BioTab2:hover ~ .BioTab2Content,
.Bio .BioTab3:hover ~ .BioTab3Content,
.Bio .BioTab4:hover  ~ .BioTab4Content {
  opacity:1;
  pointer-events:auto;
  clip-path: inset(0 0 0 0);
}

.Bio .BioTab1Content:hover,
.Bio .BioTab2Content:hover,
.Bio .BioTab3Content:hover,
.Bio .BioTab4Content:hover {
  opacity:1;
  pointer-events:auto;
  clip-path: inset(0 0 0 0);
}

.BioPlaceholder {
  background:var(--bg-panel-left);
  border:var(--border-size-small) solid var(--border-color);
  grid-column-start:2;
  grid-row-start:1;;
  grid-row-end:5;
  clip-path: inset(0 0 0 0);
  transition: clip-path .55s, opacity .15s;
  overflow-x:hidden;
  overflow-y:auto;
}

.Bio .BioTab1:hover ~ .BioPlaceholder,
.Bio .BioTab2:hover ~ .BioPlaceholder,
.Bio .BioTab3:hover ~ .BioPlaceholder,
.Bio .BioTab4:hover ~ .BioPlaceholder {
  clip-path: inset(0 0 0 100%);
}

.Bio .BioTab1Content:hover ~ .BioPlaceholder,
.Bio .BioTab2Content:hover ~ .BioPlaceholder,
.Bio .BioTab3Content:hover ~ .BioPlaceholder,
.Bio .BioTab4Content:hover ~ .BioPlaceholder {
  clip-path: inset(0 100% 0 0);
}
