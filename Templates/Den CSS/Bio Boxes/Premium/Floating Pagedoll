.pagedoll {
  position:fixed;
  left:0;
  bottom:0;
  z-index:1000;
  pointer-events:none;
  width:250px;
  animation:float 3s infinite;
}

@keyframes float {
  0% {bottom: 0px}
  10% {bottom: 1px}
  20% {bottom: 2px}
  30% {bottom: 3px}
  40% {bottom: 4px}
  50% {bottom: 5px}
  60% {bottom:4px}
  70% {bottom:3px}
  80% {bottom: 2px}
  90% {bott: 1px}
  100% {bottom:0px}
}
