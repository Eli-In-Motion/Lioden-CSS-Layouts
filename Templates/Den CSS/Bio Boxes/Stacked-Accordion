<div class="Bio">
  <div class="BioHeader"><h1>Header</h1><h2>Subheader</h2></div>
  <div class="BioTabs">
      <div class="Tab1">
        <input type="checkbox" />
        <div class="BioTab1">Tab 1</div>
        <div class="BioTab1Content">Tab 1 Content</div>
      </div>
   </div>
  </div>

.Bio {
  width:90%;
  height:fit-content;
  background:var(--bg-panel-left);
  border:var(--border-size-big) solid var(--border-color);
  border-radius:var(--border-radius-big);
  color:var(--font-color-main);
  overflow:hidden;
}

.Bio br {
  display:none;
}

.Bio h1,
.Bio h2,
.Bio h3 {
  margin:0px;
  color:var(--font-color-main);
}

.BioHeader {
  background:var(--bg-header-light);
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius-small);
  margin:15px;
  overflow:hidden;
}

.Tab {
  position:relative;
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius-small);
  margin:25px;
}

.Tab input {
  position:absolute;
  width:100%;
  top:0px;
  left:0px;
  opacity:0;
  z-index:10;
  cursor:pointer;
}

.BioTab {
  background:var(--bg-header-dark);
  border-bottom:var(--border-size-small) solid var(--border-color);
}

.BioTab h3 {
  text-align:center;
}

.BioTabContent {
  background:var(--bg-panel-right);
  text-align:left;
  height:100px;
  display:none;
  overflow-x:hidden;
  overflow-y:auto;
  padding:20px
}

.BioTabContent h3 {
  text-align:center;
}

.Tab input:checked ~ .BioTabContent {
  display:block;
}

.Tab input:not(:checked) ~ .BioTab {
  border:none;
}

.Tab1 input:checked ~ .BioTab1Content {
  display:block;
}
