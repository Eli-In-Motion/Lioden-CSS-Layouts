<div class="Bio">
  <div class="BioHeader"><h1>Header</h1><h2>Subheader</h2></div>
  <div class="BioTabs">
      <div class="Tab">
        <input type="checkbox" />
        <div class="BioTab"><h3>Tab 1</h3></div>
        <div class="BioTabContent"><h3>Tab 1 Content</h3><p>Content details</p></div>
      </div>
      <div class="Tab">
        <input type="checkbox" />
        <div class="BioTab"><h3>Tab 2</h3></div>
        <div class="BioTabContent"><h3>Tab 2 Content</h3><h3></h3><p>Content details</p></div>
      </div>
      <div class="Tab">
        <input type="checkbox" />
        <div class="BioTab"><h3>Tab 3</h3></div>
        <div class="BioTabContent"><h3>Tab 3 Content</h3><p>Content details</p></div>
      </div>
      <div class="Tab">
        <input type="checkbox" />
        <div class="BioTab"><h3>Tab 4</h3></div>
        <div class="BioTabContent"><h3>Tab 4 Content</h3><p>Content details</p></div>
      </div>
   </div>
  </div>

.Bio {
  width:90%;
  height:fit-content;
  background:var(--bg-panel-left);
  border:var(--border-size-big) solid var(--border-color);
  border-radius:var(--border-radius-big);
  color:var(--font-color-main);
  overflow:hidden;
}

.Bio br {
  display:none;
}

.Bio h1,
.Bio h2,
.Bio h3 {
  margin:0px;
  color:var(--font-color-main);
}

.Bio img {
  width:80%;
  margin:auto;
}

.BioHeader {
  background:var(--bg-header-light);
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius-small);
  margin:30px;
  overflow:hidden;
}

.Tab {
  position:relative;
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius-small);
  margin-bottom:20px;
  width:85%
}

.Tab input {
  position:absolute;
  width:100%;
  height:100%;
  top:0px;
  left:0px;
  appearance:none;
  z-index:2;
  cursor:pointer;
  margin:0px;
  border-radius:var(--border-radius-small);
}

.BioTab {
  background:var(--bg-header-dark);
  padding:5px;
}

.BioTab h3 {
  text-align:center;
}

.Tab input:hover {
  box-shadow:0px 0px 10px 2px var(--accent-color-light);
}

.Tab input:checked ~ .BioTabContent {
  display:block;
}

.Tab input:not(:checked) ~ .BioTab {
  border:none;
}

.BioTabContent {
  background:var(--bg-panel-right);
  text-align:left;
  height:150px;
  display:none;
  overflow-x:hidden;
  overflow-y:auto;
  padding:20px;
  padding-top:15px;
}

.BioTabContent h3 {
  text-align:center;
}
