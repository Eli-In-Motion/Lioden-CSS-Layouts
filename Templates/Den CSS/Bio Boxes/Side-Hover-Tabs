.Bio {
  width:100%;
  height:300px;
  display:grid;
  grid-template-rows: auto minmax(0, 1fr);
  margin-bottom:30px;
  box-sizing: border-box;
}

.Bio br {
  display:none;
}

.Bio h1,
.Bio h2 {
  margin: 0;
}

.BioHeader {
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius);
  text-align:center;
  padding:15px;
  background:var(--bg-header-light);
}

.Bio .BioHeader h1 {
  color:var(--font-color-main);
  text-align:center;
  font-size:40px;
}

.Bio .BioHeader h2 {
  color:var(--font-color-main);
  text-align:center;
  font-size:20px;
}

.BioTabCol {
  display:grid;
  grid-template-columns:1fr 3fr;
  grid-template-rows: repeat(4, minmax(0, 1fr));
  height:100%;
}

.BioTab1,
.BioTab2,
.BioTab3,
.BioTab4 {
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:1;
  overflow:hidden;
  text-align:center;
  padding:13px;
  font-size:20px;
  box-sizing: border-box;
  background:var(--bg-panel-left);
}

.BioTab1:hover,
.BioTab2:hover,
.BioTab3:hover,
.BioTab4:hover {
  color:var(--accent-color-light);
  border-color:var(--accent-color-light);
}

.BioTabContent {
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  overflow-x:hidden;
  overflow-y:auto;
  background:var(--bg-panel-right);
}

.BioTab1Content,
.BioTab2Content,
.BioTab3Content,
.BioTab4Content {
  border:var(--border-size-small) solid var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  display:none;
  overflow-x:hidden;
  overflow-y:auto;
  padding:20px;
  background:var(--bg-panel-right);
}

.BioTab1Content h2,
.BioTab2Content h2,
.BioTab3Content h2,
.BioTab4Content h2 {
  text-align:center;
}

.BioTab1Content p,
.BioTab2Content p,
.BioTab3Content p,
.BioTab4Content p {
  text-align:left;
}

.BioTab1Content::-webkit-scrollbar,
.BioTab2Content::-webkit-scrollbar,
.BioTab3Content::-webkit-scrollbar,
.BioTab4Content::-webkit-scrollbar {
  width:10px;
}

.BioTab1Content::-webkit-scrollbar-track,
.BioTab2Content::-webkit-scrollbar-track,
.BioTab3Content::-webkit-scrollbar-track,
.BioTab4Content::-webkit-scrollbar-track {
  background:red;
}

.BioTab1Content::-webkit-scrollbar-thumb,
.BioTab2Content::-webkit-scrollbar-thumb,
.BioTab3Content::-webkit-scrollbar-thumb,
.BioTab4Content::-webkit-scrollbar-thumb {
  background:black;
}

.BioTab1:hover ~ .BioTab1Content,
.BioTab2:hover ~ .BioTab2Content,
.BioTab3:hover ~ .BioTab3Content,
.BioTab4:hover ~ .BioTab4Content,
.BioTab1Content:hover,
.BioTab2Content:hover,
.BioTab3Content:hover,
.BioTab4Content:hover {
  display:block;
}
