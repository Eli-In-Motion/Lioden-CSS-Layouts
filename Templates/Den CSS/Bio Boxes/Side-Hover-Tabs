.Bio {
  width:100%;
  height:400px;
  display:grid;
  grid-template-rows: auto minmax(0, 2fr);
  margin-bottom:30px;
  box-sizing: border-box;
  width:95%;
}

.Bio br {
  display:none;
}

.Bio h1,
.Bio h2 {
  margin: 0;
  color:var(--font-color-main);
  text-align:center;
}

.Bio h1 {
  margin-bottom:10px;
}

.Bio p {
  text-align:left;
  color:var(--font-color-main);
}

.BioHeader {
  border:var(--border-size-small) solid var(--border-color);
  border-top-left-radius:var(--border-radius-big);
  border-top-right-radius:var(--border-radius-big);
  text-align:center;
  padding:10px;
  background:var(--bg-header-light);
}

.Bio .BioHeader h1 {
  font-size:30px;
}

.Bio .BioHeader h2 {
  font-size:20px;
}

.BioTabCol {
  display:grid;
  grid-template-columns:1fr 3fr;
  grid-template-rows: repeat(4, minmax(0, 1fr));
  height:100%;
}

.BioTab1,
.BioTab2,
.BioTab3,
.BioTab4 {
  border-style:none solid solid solid;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:1;
  overflow:hidden;
  text-align:center;
  padding:13px;
  font-size:20px;
  box-sizing: border-box;
  background:var(--bg-panel-left);
  cursor:pointer;
}

.BioTab4 {
  border-bottom-left-radius:var(--border-radius-big);
}

.BioTab1:hover,
.BioTab2:hover,
.BioTab3:hover,
.BioTab4:hover {
  color:var(--accent-color-light);
  background:var(--bg-panel-back);
  box-shadow:0px 0px 10px 2px var(--accent-color-light);
  z-index: 10;
}

.BioTabContent {
  border-style:none solid solid none;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  overflow-x:hidden;
  overflow-y:auto;
  background:var(--bg-panel-right);
  border-bottom-right-radius:var(--border-radius-big);
}

.BioTab1Content,
.BioTab2Content,
.BioTab3Content,
.BioTab4Content {
  border-style:none solid solid none;
  border-width:var(--border-size-small);
  border-color:var(--border-color);
  border-radius:var(--border-radius);
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  display:none;
  overflow-x:hidden;
  overflow-y:auto;
  padding:20px;
  padding-left:30px;
  padding-right:30px;
  background:var(--bg-panel-right);
  border-bottom-right-radius:var(--border-radius-big);
}

.BioTab1Content::-webkit-scrollbar,
.BioTab2Content::-webkit-scrollbar,
.BioTab3Content::-webkit-scrollbar,
.BioTab4Content::-webkit-scrollbar {
  width:10px;
}

.BioTab1Content::-webkit-scrollbar-track,
.BioTab2Content::-webkit-scrollbar-track,
.BioTab3Content::-webkit-scrollbar-track,
.BioTab4Content::-webkit-scrollbar-track {
  background:var(--bg-header-light);
}

.BioTab1Content::-webkit-scrollbar-thumb,
.BioTab2Content::-webkit-scrollbar-thumb,
.BioTab3Content::-webkit-scrollbar-thumb,
.BioTab4Content::-webkit-scrollbar-thumb {
  background:var(--bg-header-dark);
}

.BioTab1:hover ~ .BioTab1Content,
.BioTab2:hover ~ .BioTab2Content,
.BioTab3:hover ~ .BioTab3Content,
.BioTab4:hover ~ .BioTab4Content,
.BioTab1Content:hover,
.BioTab2Content:hover,
.BioTab3Content:hover,
.BioTab4Content:hover {
  display:block;
}
