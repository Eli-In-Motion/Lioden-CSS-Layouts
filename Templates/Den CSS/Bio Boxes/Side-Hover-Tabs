.Bio {
  width:100%;
  height:300px;
  display:grid;
  grid-template-rows:50px 150px;
}

.BioHeader {
  border:1px solid red;
  text-align:center;
  padding:10px;
}

.BioTabCol {
  display:grid;
  grid-template-columns:1fr 2fr;
  grid-template-rows:1fr 1fr 1fr 1fr;
  height:150px;
}

.BioTab1,
.BioTab2,
.BioTab3,
.BioTab4 {
  border:1px solid red;
  grid-column-start:1;
  overflow:hidden;
}

.BioTabContent {
  border:1px solid red;
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  overflow-x:hidden;
  overflow-y:auto;
}

.BioTab1Content,
.BioTab2Content,
.BioTab3Content,
.BioTab4Content {
  border:1px solid red;
  grid-column-start:2;
  grid-row-start:1;
  grid-row-end:5;
  display:none;
  overflow-x:hidden;
  overflow-y:auto;
}

.BioTab1:hover ~ .BioTab1Content,
.BioTab2:hover ~ .BioTab2Content,
.BioTab3:hover ~ .BioTab3Content,
.BioTab4:hover ~ .BioTab4Content,
.BioTab1Content:hover,
.BioTab2Content:hover,
.BioTab3Content:hover,
.BioTab4Content:hover {
  display:block;
}
